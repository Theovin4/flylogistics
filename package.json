{
  "name": "fly-logistics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run validate && prisma generate && next build",
    "validate": "npm run typecheck && npm run lint && npm run security:scan && npm test",
    "verify": "npm run validate",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:apply:supabase": "node scripts/apply-supabase-sql.mjs",
    "db:verify:supabase": "node scripts/verify-supabase-tables.mjs",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/export-supabase-db.ps1",
    "backup:db:schema": "powershell -ExecutionPolicy Bypass -File scripts/export-supabase-db.ps1 -SchemaOnly",
    "security:scan": "node scripts/check-client-secrets.mjs",
    "seo:audit": "node scripts/audit-seo-crawl.mjs",
    "load:test": "node scripts/load-test.mjs",
    "notifications:test:resend": "node scripts/send-resend-delivery-test.mjs",
    "notifications:test:whatsapp": "node scripts/send-whatsapp-cloud-test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/fiber": "^9.4.0",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "framer-motion": "^12.23.22",
    "groq-sdk": "^1.2.0",
    "gsap": "^3.13.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "mapbox-gl": "^3.15.0",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "openai": "^5.23.1",
    "prisma": "^6.16.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.2",
    "redis": "^5.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "tsx": "^4.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.180.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.23",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "nanoid": "^3.3.17",
    "js-yaml": "^4.3.1",
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.9"
    }
  }
}
