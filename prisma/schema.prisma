generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  DRIVER
  DISPATCHER
  ADMIN
  FINANCE
  SUPPORT
}

enum ShipmentStatus {
  QUOTED
  BOOKED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  role            Role             @default(CUSTOMER)
  company         String?
  phone           String?
  accounts        Account[]
  sessions        Session[]
  shipments       Shipment[]       @relation("CustomerShipments")
  driverProfile   Driver?
  invoices        Invoice[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  auditLogs        AuditLog[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Driver {
  id             String      @id @default(cuid())
  userId         String      @unique
  licenseNumber  String      @unique
  availability   Boolean     @default(false)
  rating         Float       @default(5)
  earningsCents  Int         @default(0)
  currentLat     Float?
  currentLng     Float?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  assignments    Shipment[]
  proofDocuments ProofOfDelivery[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Vehicle {
  id             String     @id @default(cuid())
  driverId       String?
  vin            String     @unique
  plateNumber    String     @unique
  type           String
  capacityKg     Int
  temperatureMin Float?
  temperatureMax Float?
  status         String     @default("ACTIVE")
  driver         Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)
  shipments      Shipment[]
  telemetry      VehicleTelemetry[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Shipment {
  id                 String              @id @default(cuid())
  trackingId         String              @unique
  customerId         String
  driverId           String?
  vehicleId          String?
  routeId            String?
  warehouseId        String?
  status             ShipmentStatus      @default(QUOTED)
  origin             String
  destination        String
  originLat          Float?
  originLng          Float?
  destinationLat     Float?
  destinationLng     Float?
  weightKg           Float
  cargoValueCents    Int
  urgency            String              @default("standard")
  quotedPriceCents   Int
  eta                DateTime?
  deliveryConfidence Int                 @default(95)
  customer           User                @relation("CustomerShipments", fields: [customerId], references: [id])
  driver             Driver?             @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle            Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  route              Route?              @relation(fields: [routeId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  invoices           Invoice[]
  events             ShipmentEvent[]
  proofOfDelivery    ProofOfDelivery?
  supportTickets     SupportTicket[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([customerId, status])
  @@index([driverId, status])
  @@index([trackingId])
}

model Route {
  id              String     @id @default(cuid())
  name            String
  geometry        Json
  distanceKm      Float
  estimatedHours  Float
  fuelEstimateLiters Float
  optimizationScore Int      @default(90)
  trafficRisk     String     @default("LOW")
  shipments       Shipment[]
  aiLogs          AILog[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  label       String
  location    String?
  lat         Float?
  lng         Float?
  occurredAt  DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model Invoice {
  id              String    @id @default(cuid())
  userId          String
  shipmentId      String?
  number          String    @unique
  amountCents     Int
  currency        String    @default("USD")
  status          String    @default("OPEN")
  stripePaymentId String?
  dueAt           DateTime?
  paidAt          DateTime?
  user            User      @relation(fields: [userId], references: [id])
  shipment        Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
}

model Warehouse {
  id         String     @id @default(cuid())
  name       String
  code       String     @unique
  address    String
  lat        Float
  lng        Float
  capacity   Int
  utilization Float     @default(0)
  shipments  Shipment[]
  inventory  WarehouseInventory[]
  analytics  AnalyticsEvent[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model WarehouseInventory {
  id          String    @id @default(cuid())
  warehouseId String
  sku         String
  description String
  quantity    Int
  reserved    Int       @default(0)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, sku])
}

model AnalyticsEvent {
  id          String     @id @default(cuid())
  warehouseId String?
  type        String
  value       Float
  dimension   Json?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([type, createdAt])
}

model AILog {
  id          String   @id @default(cuid())
  routeId     String?
  userId      String?
  feature     String
  prompt      String   @db.Text
  response    String   @db.Text
  tokens      Int      @default(0)
  latencyMs   Int      @default(0)
  model       String
  route       Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([feature, createdAt])
}

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String
  shipmentId  String?
  subject     String
  priority    String    @default("NORMAL")
  status      String    @default("OPEN")
  messages    Json
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipment    Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProofOfDelivery {
  id          String   @id @default(cuid())
  shipmentId  String   @unique
  driverId    String
  signatureUrl String?
  imageUrl    String?
  lat         Float
  lng         Float
  recipient   String
  notes       String?
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver      Driver   @relation(fields: [driverId], references: [id])
  createdAt   DateTime @default(now())
}

model VehicleTelemetry {
  id        String   @id @default(cuid())
  vehicleId String
  lat       Float
  lng       Float
  speedKph  Float
  fuelPct   Float?
  batteryPct Float?
  payloadKg Float?
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
